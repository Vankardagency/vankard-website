---
import Layout from '../layouts/Layout.astro';import CTA from '../components/CTA.astro';import {basePrices,formatAmount,offerSummary} from '../lib/pricing.mjs';
---
<Layout title="Recover pricing"><section class="page-hero grid-paper"><span class="eyebrow">A clear starting point</span><h1>Start with Recover.<br/><em>Earn what comes next.</em></h1><p>One managed service to turn existing visitor interest<br/>into more useful conversations.</p></section><section class="section"><div class="pricing-controls"><div class="billing-control segmented" role="group" aria-label="Billing period"><button data-billing="quarterly" aria-pressed="true">Quarterly billing</button><button data-billing="monthly" aria-pressed="false">Monthly billing</button></div><label class="currency-control" for="pricing-currency">Display currency <select id="pricing-currency" disabled><option value="USD" selected>USD · US Dollar</option><option value="QAR">QAR · Qatari Riyal</option></select></label></div><div class="pricing-grid"><article class="price-card featured"><div class="price-head"><span class="eyebrow">01 / Recover</span><span class="tag">START HERE</span></div><div aria-live="polite" aria-atomic="true"><h2><span id="price-symbol">$</span><span id="price-value">{formatAmount(basePrices.quarterlyMonthly)}</span><small id="price-unit"> USD equivalent / month</small></h2><p id="price-description">${formatAmount(basePrices.quarterlyTotal)} USD equivalent billed per quarter.</p></div><p class="billing-facts">{offerSummary()}</p><details class="qar-reference"><summary>Original QAR offer</summary><p>6,000 QAR/month billed as 18,000 QAR per quarter, or 8,000 QAR paid monthly.</p></details><p class="price-sub">Your managed AI sales layer.</p><button class="button" data-chat>Find out if we fit ↗</button><ul>{['Vanka AI installed in 48 hours*','Visitor conversations, around the clock','Scripts written for your offer','CRM connection','14 days of post-launch tuning','5am brief in plain English'].map(t=><li>{t}</li>)}</ul><small>No performance guarantee. No refunds.</small></article><article class="price-card"><span class="eyebrow">02 / Optimize</span><h2>Unlocked<br/><em>by progress.</em></h2><p>For qualified active Recover clients.</p><div class="locked-note">Scope and price revealed<br/>after qualification.</div><p>Improve the experience using evidence from conversations and your conversion journey.</p><a class="text-link" href="/solutions/#optimize">About Optimize ↗</a></article><article class="price-card"><span class="eyebrow">03 / Scale</span><h2>Built on<br/><em>what works.</em></h2><p>For qualified active Optimize clients.</p><div class="locked-note">Scope and price revealed<br/>after qualification.</div><p>Expand acquisition after you have strengthened what happens after the click.</p><a class="text-link" href="/solutions/#scale">About Scale ↗</a></article></div><p class="footnote">*48 hours begins after required access, offer information and approvals are available. No results are guaranteed. Payments are non-refundable.</p></section><section class="section split"><h2>You don’t need<br/>more software.<br/><em>You need it working.</em></h2><div><p>Recover includes the implementation and ongoing operation behind the experience. We write the scripts, connect the CRM and tune the conversations.</p><p>If your website is not attracting enough relevant traffic yet, Recover may not be the right starting point. The fit conversation is there to make that clear.</p><a class="text-link" href="/faq/">Read the FAQs ↗</a></div></section><CTA/><script>
import {basePrices,formatAmount,normalizeCurrency,storedCurrency,saveCurrency} from '../lib/pricing.mjs';
const select=document.querySelector('#pricing-currency') as HTMLSelectElement;
let currency=storedCurrency();let billing='quarterly';
function renderPrice(){
 const q=billing==='quarterly';
 document.querySelector('#price-symbol')!.textContent=currency==='USD'?'$':'';
 document.querySelector('#price-value')!.textContent=formatAmount(q?basePrices.quarterlyMonthly:basePrices.monthly,currency);
 document.querySelector('#price-unit')!.textContent=` ${currency}${currency==='USD'?' equivalent':''} / month`;
 const amount=formatAmount(q?basePrices.quarterlyTotal:basePrices.monthly,currency);
 document.querySelector('#price-description')!.textContent=`${currency==='USD'?'$':''}${amount} ${currency}${currency==='USD'?' equivalent':''} billed ${q?'per quarter':'monthly'}.`;
 document.querySelectorAll('[data-billing]').forEach(b=>b.setAttribute('aria-pressed',String(b.getAttribute('data-billing')===billing)));
}
select.value=currency;select.disabled=false;renderPrice();
select.addEventListener('change',()=>{currency=normalizeCurrency(select.value);saveCurrency(currency);renderPrice();});
document.querySelectorAll('[data-billing]').forEach(b=>b.addEventListener('click',()=>{billing=b.getAttribute('data-billing')==='monthly'?'monthly':'quarterly';renderPrice();}));
</script></Layout>
