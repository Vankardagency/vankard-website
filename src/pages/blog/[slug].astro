---
import Layout from '../../layouts/Layout.astro';import CTA from '../../components/CTA.astro';import {getContent} from '../../lib/content';export async function getStaticPaths(){const {posts}=await getContent();return posts.map(post=>({params:{slug:post.slug},props:{post,related:posts.filter(p=>p.slug!==post.slug).slice(0,2)}}));}const {post,related}=Astro.props;
---
<Layout title={post.title} description={post.excerpt} article={post}><section class="page-hero article-hero grid-paper"><a class="text-link" href="/blog/">← All insights</a><span class="eyebrow">{post.category} · {post.readTime}</span><h1>{post.title}</h1><p>{post.excerpt}</p><small>Vankard / Field notes</small></section><article class="article-body">{post.body.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}<div class="article-next"><span class="eyebrow">Keep exploring</span>{related.map(p=><a href={`/blog/${p.slug}/`}>{p.title} ↗</a>)}</div></article><CTA/></Layout>
