---
import Layout from '../../layouts/Layout.astro';import {getContent} from '../../lib/content';const {posts}=await getContent();
---
<Layout title="Insights on conversion and growth"><section class="page-hero grid-paper"><span class="eyebrow">Vankard / Field notes</span><h1>Less noise.<br/><em>Better growth questions.</em></h1><p>Ideas on conversion, buying behavior and making more<br/>of the demand you already have.</p></section><section class="section"><label class="search-label" for="article-search">Find an insight</label><input class="article-search" id="article-search" type="search" placeholder="Search articles…"/><div class="three-grid blog-grid">{posts.map((p,i)=><a class="article-card" data-article={`${p.title} ${p.category} ${p.excerpt}`.toLowerCase()} href={`/blog/${p.slug}/`}><div class={`article-art art-${i%3}`}><span>{['↗','“ ”','01 → 03'][i%3]}</span><small>VANKARD / FIELD NOTES</small></div><span class="eyebrow">{p.category} · {p.readTime}</span><h3>{p.title}</h3><p>{p.excerpt}</p><span class="text-link">Read the article ↗</span></a>)}</div><p id="no-results" hidden>No articles match your search. Try another term.</p></section><script>const input=document.querySelector('#article-search') as HTMLInputElement;input?.addEventListener('input',()=>{let found=0;document.querySelectorAll('[data-article]').forEach(el=>{const visible=el.getAttribute('data-article')!.includes(input.value.toLowerCase().trim());(el as HTMLElement).hidden=!visible;if(visible)found++;});(document.querySelector('#no-results') as HTMLElement).hidden=found>0;});</script></Layout>
