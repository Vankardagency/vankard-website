---
import '../styles/global.css';
import Chat from '../components/Chat.astro';
import {pageMetadata,indexable,schemaGraph} from '../lib/seo';
const path=Astro.url.pathname;
const metadata=pageMetadata[path];
const {article,faqItems}=Astro.props;
const title=metadata?.title ?? Astro.props.title ?? 'Vankard';
const description=Astro.props.description ?? metadata?.description ?? 'Vankard helps businesses turn existing website traffic into qualified conversations.';
const fullTitle=title.includes('Vankard') ? title : `${title} | Vankard`;
const canonical=Astro.site && path!=='/404.html' && path!=='/404/' ? new URL(path,Astro.site) : undefined;
const crawlable=indexable && path!=='/404.html' && path!=='/404/';
const schema=Astro.site && path!=='/404.html' && path!=='/404/' ? schemaGraph({site:Astro.site,path,title:fullTitle,description,article,faqs:faqItems}) : undefined;
const breadcrumb=path!=='/' && path!=='/404.html' && path!=='/404/';
const links=[['How it works','/how-it-works/'],['Solutions','/solutions/'],['Pricing','/pricing/'],['Insights','/blog/'],['About','/about/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#fbfaf8"/><title>{fullTitle}</title><meta name="robots" content={crawlable?'index,follow,max-image-preview:large':'noindex,follow'}/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:site_name" content="Vankard"/><meta property="og:locale" content="en_US"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/>{canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/> }</head><body><a class="skip" href="#main">Skip to content</a><header class="header"><div class="nav-wrap"><a class="wordmark" href="/" aria-label="Vankard home">vankard<span>®</span></a><nav aria-label="Main navigation" id="main-nav">{links.map(([label,href])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}</nav><a class="nav-demo" href="/demo/">Try the demo ↗</a><button class="button small" data-chat>Find your fit <span>→</span></button><button class="menu" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">☰</button></div></header><main id="main">{breadcrumb && <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{article && <><a href="/blog/">Insights</a><span aria-hidden="true">/</span></>}<span aria-current="page">{article ? article.title : path==='/blog/' ? 'Insights' : path.slice(1).replace(/\/$/,'').replace(/-/g,' ')}</span></nav>}<slot/></main><footer><div class="footer-top"><div><a class="wordmark" href="/">vankard<span>®</span></a><p>Good traffic deserves<br/>a better ending.</p></div><div><span class="eyebrow">Explore</span>{links.map(([label,href])=><a href={href}>{label}</a>)}</div><div><span class="eyebrow">Take a closer look</span><a href="/demo/">Interactive demo</a><a href="/faq/">Frequently asked questions</a><button class="text-link" data-chat>Talk to Vanka ↗</button></div><div class="footer-note"><span class="signal"></span> Built for the moment<br/>a visitor becomes a buyer.</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Vankard.</span><span>Recover. Optimize. Scale.</span><span>Website demonstration · Integrations pending</span></div></footer><Chat/><script>const menu=document.querySelector('.menu');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.getElementById('main-nav')?.classList.toggle('open',open);});</script></body></html>
