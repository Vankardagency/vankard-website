<section class="demo-shell" aria-label="Interactive visitor journey demonstration"><div class="demo-bar"><span><span class="signal"></span> THE MOMENT THAT MATTERS</span><div class="segmented"><button data-mode="without" aria-pressed="false">Without Vankard</button><button data-mode="with" aria-pressed="true">With Vankard</button></div></div><div class="demo-grid"><div class="visitor-panel"><div class="browser-bar"><span>● ● ●</span><span>yourwebsite.com / pricing</span><span>↗</span></div><div class="visitor-title"><span class="eyebrow">Visitor 0248 · Illustrative scenario</span><h3>Someone is considering<br/>your business. <em>Right now.</em></h3><p>Returning visitor. Pricing page. One unanswered question.</p></div><div class="journey"><span>01<br/><b>Arrives</b></span><i></i><span>02<br/><b>Explores</b></span><i></i><span class="journey-last">03<br/><b>Gets an answer</b></span></div><div class="conversation"><div class="avatar">v</div><div><strong>Vanka <span>AI assistant</span></strong><p id="demo-message">Back for another look? Want to talk through pricing or see if this is right for you?</p><button class="demo-reply" data-chat>“Is this a good fit for my business?” ↗</button></div></div></div><aside class="event-panel"><span class="eyebrow">Intent → Conversation → Next step</span><div class="events"><p><span>01</span><b>Recognize the moment</b><small>A visitor explores your offer.</small></p><p><span>02</span><b id="event-two">Start a useful conversation</b><small id="event-two-small">Answer the question behind the hesitation.</small></p><p><span>03</span><b id="event-three">Make the next step easy</b><small id="event-three-small">Qualify interest. Help arrange a meeting.</small></p></div><div class="demo-result"><span class="signal"></span><span id="demo-result">A conversation, while intent is still here.</span></div></aside></div><div class="demo-foot">INTERACTIVE DEMONSTRATION <span>Illustrative activity. No real tracking, calls or bookings.</span></div></section>
<script>document.querySelectorAll('[data-mode]').forEach(button=>button.addEventListener('click',()=>{const active=button.getAttribute('data-mode')==='with';document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const set=(id,text)=>{const el=document.getElementById(id);if(el)el.textContent=text;};set('demo-message',active?'Back for another look? Want to talk through pricing or see if this is right for you?':'Please fill in our contact form. Someone will get back to you.');set('event-two',active?'Start a useful conversation':'The question goes unanswered');set('event-two-small',active?'Answer the question behind the hesitation.':'The visitor has to do the chasing.');set('event-three',active?'Make the next step easy':'The moment passes');set('event-three-small',active?'Qualify interest. Help arrange a meeting.':'No conversation. No clear next step.');set('demo-result',active?'A conversation, while intent is still here.':'The visitor leaves without an answer.');document.querySelector('.demo-shell')?.classList.toggle('without',!active);}));</script>
