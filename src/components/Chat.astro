<button class="chat-launch" data-chat aria-label="Open Vanka demo">✳ <span>Talk to Vanka</span></button><dialog id="vanka-dialog" aria-labelledby="chat-title"><div class="chat-head"><div class="avatar">v</div><div><strong id="chat-title">Vanka</strong><small>Interactive demo · Not a live agent</small></div><button id="close-chat" aria-label="Close conversation">✕</button></div><div class="chat-body" id="chat-body" aria-live="polite"></div><form id="chat-form"><label for="chat-input" id="chat-label">Your website</label><input id="chat-input" autocomplete="url" placeholder="example.com" required maxlength="300"/><button class="button" type="submit">Continue →</button></form><div class="chat-actions"><button id="restart-chat">Restart</button><button id="download-summary" hidden>Download my summary ↓</button></div><small class="chat-disclosure">Demo only. Answers stay in this browser session and are not sent to Vankard. No booking or application is submitted.</small></dialog>
<script>
import {offerSummary,storedCurrency} from '../lib/pricing.mjs';
const dialog=document.querySelector('#vanka-dialog') as HTMLDialogElement;const body=document.querySelector('#chat-body')!;const form=document.querySelector('#chat-form') as HTMLFormElement;const input=document.querySelector('#chat-input') as HTMLInputElement;const label=document.querySelector('#chat-label')!;const download=document.querySelector('#download-summary') as HTMLButtonElement;
let step=0;let answers:string[]=[];const prompts=['What is your website?','Roughly how many website visitors do you get each month?','How many meetings does your website generate in a typical month?','What happens when a visitor asks a question outside business hours?','What would you most like to improve?'];
function message(text:string,kind='assistant'){const el=document.createElement('p');el.className='chat-message '+kind;el.textContent=text;body.appendChild(el);el.scrollIntoView({block:'nearest'});}
function reset(){step=0;answers=[];body.replaceChildren();message('Let’s see where your website might be losing conversations. This is a guided demo, not a live application.');message(prompts[0]);form.hidden=false;input.value='';label.textContent='Your website';input.placeholder='example.com';download.hidden=true;}
document.querySelectorAll('[data-chat]').forEach(b=>b.addEventListener('click',()=>{if(!body.children.length)reset();dialog.showModal();input.focus();}));document.querySelector('#close-chat')?.addEventListener('click',()=>dialog.close());document.querySelector('#restart-chat')?.addEventListener('click',reset);
form.addEventListener('submit',e=>{e.preventDefault();const value=input.value.trim();if(!value)return;answers.push(value);message(value,'user');step++;input.value='';if(step<prompts.length){message(prompts[step]);label.textContent=prompts[step];input.placeholder='Your answer…';input.focus();}else{form.hidden=true;message('Thanks. Your starting point is Recover: '+offerSummary(storedCurrency())+' No performance guarantee or refunds.');message('A real fit decision needs a review of your traffic and offer. Download your answers to keep them for that conversation. Nothing has been submitted or booked.');download.hidden=false;}});
download.addEventListener('click',()=>{const text='VANKARD · Recovery conversation summary\n\n'+answers.map((a,i)=>prompts[i]+'\n'+a).join('\n\n')+'\n\nDemo only. Not an application or confirmed booking.';const url=URL.createObjectURL(new Blob([text],{type:'text/plain'}));const a=document.createElement('a');a.href=url;a.download='vankard-conversation.txt';a.click();URL.revokeObjectURL(url);});
</script>
